CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/sistemalocal26-3/public/'
app.forceGlobalSecureRequests = false

database.default.hostname = localhost
database.default.database = sistemalocal
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Para que no salga el error de DebugBar
toolbar.collectors[] = CodeIgniter\Debug\Toolbar\Collectors\Timers
toolbar.collectors[] = CodeIgniter\Debug\Toolbar\Collectors\Logs
toolbar.collectors[] = CodeIgniter\Debug\Toolbar\Collectors\Views
toolbar.collectors[] = CodeIgniter\Debug\Toolbar\Collectors\Routes